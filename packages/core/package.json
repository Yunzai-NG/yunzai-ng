{
  "name": "@yunzai-ng/core",
  "version": "0.7.0",
  "description": "Yunzai NG 内核：插件宿主、统一事件模型、中间件管线、存储与渲染抽象",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Yunzai-NG/yunzai-ng#readme",
  "bugs": "https://github.com/Yunzai-NG/yunzai-ng/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yunzai-NG/yunzai-ng.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/bundle.mjs"
  },
  "dependencies": {
    "@yunzai-ng/types": "workspace:*",
    "croner": "^9.0.0",
    "fastify": "^5.2.1",
    "undici": "^7.3.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1",
    "classic-level": "^2.0.0"
  },
  "devDependencies": {
    "@fastify/send": "^4.1.1",
    "@fastify/websocket": "^11.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "yaml": "^2.7.0"
  }
}
