{
  "name": "@yunzai-ng/cli",
  "version": "0.3.2",
  "description": "Yunzai NG 命令行：init / start / dev / doctor / plugin",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Yunzai-NG/yunzai-ng#readme",
  "bugs": "https://github.com/Yunzai-NG/yunzai-ng/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yunzai-NG/yunzai-ng.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "yzng": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@yunzai-ng/core": "workspace:*",
    "@yunzai-ng/jsx": "workspace:*",
    "@yunzai-ng/types": "workspace:*"
  }
}
